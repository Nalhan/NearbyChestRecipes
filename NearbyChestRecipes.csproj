<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>NearbyChestRecipes</AssemblyName>
    <RootNamespace>NearbyChestRecipes</RootNamespace>
    <Version>1.0.0</Version>

    <!-- Path resolution: checks CLI property, local server, or CI directory -->
    <ValheimManaged Condition="'$(ValheimManaged)' == '' and Exists('/home/pergola/valheim/data/server/valheim_server_Data/Managed')">/home/pergola/valheim/data/server/valheim_server_Data/Managed</ValheimManaged>
    <ValheimManaged Condition="'$(ValheimManaged)' == '' and Exists('$(MSBuildThisFileDirectory)valheim_server/valheim_server_Data/Managed')">$(MSBuildThisFileDirectory)valheim_server/valheim_server_Data/Managed</ValheimManaged>

    <BepInExCore Condition="'$(BepInExCore)' == '' and Exists('/home/pergola/valheim/data/bepinex/BepInEx/core')">/home/pergola/valheim/data/bepinex/BepInEx/core</BepInExCore>
    <BepInExCore Condition="'$(BepInExCore)' == '' and Exists('$(MSBuildThisFileDirectory)bepinex_pack/BepInExPack_Valheim/BepInEx/core')">$(MSBuildThisFileDirectory)bepinex_pack/BepInExPack_Valheim/BepInEx/core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManaged)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManaged)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimManaged)/assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
